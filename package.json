{
  "name": "clipping-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "bundle:ffmpeg": "node scripts/bundle-ffmpeg.mjs",
    "dev": "npm --workspace apps/desktop run dev",
    "build": "npm --workspace apps/desktop run build",
    "typecheck": "npm --workspace apps/desktop run typecheck",
    "test:desktop": "node --experimental-strip-types --test \"apps/desktop/tests/*.test.mjs\"",
    "test:engine": "node scripts/run-engine-tests.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "dist": "npm run licenses && npm run build:engine && npm --workspace apps/desktop run dist",
    "release": "npm run licenses && npm run build:engine && npm --workspace apps/desktop run release",
    "clip": "node scripts/clip.mjs"
  }
}
