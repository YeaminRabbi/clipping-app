+          onDragOver={(e) => {
+            e.preventDefault()
+            e.stopPropagation()
+            setDragging(true)
+          }}
+          onDragLeave={(e) => {
+            if (!e.currentTarget.contains(e.relatedTarget as Node)) setDragging(false)
+          }}
+          onDrop={onDrop}
+        >
+          {paths.length === 0 ? (
+            <button
+              onClick={() => void browse()}
+              data-autofocus
