   background:
-    radial-gradient(760px 520px at 30% -180px, rgba(35, 65, 111, 0.55), transparent 70%),
-    radial-gradient(620px 560px at calc(100% + 120px) calc(100% + 180px), rgba(26, 47, 85, 0.75), transparent 70%),
