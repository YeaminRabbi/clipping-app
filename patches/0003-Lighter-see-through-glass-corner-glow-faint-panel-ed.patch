     var(--ui-canvas);
   background-attachment: fixed;
   color: var(--ui-ink);
@@ -213,15 +216,30 @@ kbd {
 
 /* ---- Redesign: glass surfaces and pill controls ---- */
 
-/* Panels are translucent and carry a top-edge sheen. Blur is reserved for floating layers
-   (sidebar, dialogs) so the GPU isn't re-blurring large areas while video plays. */
+/* Panels are see-through with a faint edge and a soft sheen at the top, so the background glow shows
+   through them. They aren't blurred: blur is reserved for floating layers (sidebar, dialogs) so the GPU
+   isn't re-blurring large areas while video plays. */
+.bg-panel,
+.bg-panel-2 {
+  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0) 45%);
+}
+
 .bg-panel {
   box-shadow: var(--ui-glass-highlight);
 }
 
+/* Floating glass (sidebar, dialogs): frosted, see-through, with a brighter edge. */
 .glass-float {
   backdrop-filter: var(--ui-glass-blur);
   -webkit-backdrop-filter: var(--ui-glass-blur);
+  border-color: var(--ui-glass-edge);
+  background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015) 55%);
+}
+
+/* Behind a dialog, the whole app is blurred and dimmed. Only while a dialog is open. */
+.modal-backdrop {
+  backdrop-filter: var(--ui-backdrop-blur);
+  -webkit-backdrop-filter: var(--ui-backdrop-blur);
 }
 
